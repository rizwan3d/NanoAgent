<idea-plugin>
    <id>com.stemcode.plugin</id>
    <name>StemCode</name>
    <vendor>ALFAIN Technologies (PVT) Limited</vendor>
    <description><![CDATA[
        <h3>StemCode - AI Coding Agent</h3>
        <p>
            StemCode brings an autonomous AI coding assistant directly into your IDE.
            It can read and edit files, run shell commands, search code, browse the web,
            and more — all through natural language conversations.
        </p>
        <ul>
            <li><strong>Autonomous:</strong> The agent plans and executes multi-step tasks</li>
            <li><strong>Context-aware:</strong> Understands your project structure and code</li>
            <li><strong>Tool-rich:</strong> File operations, shell, browser, search, and more</li>
            <li><strong>Session management:</strong> Save and resume conversations</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>v0.2.0</h3>
        <ul>
            <li>Rich chat UI with message streaming, tool calls, plans, and settings</li>
            <li>Editor integration: send selection, current file, review, explain, git diff</li>
            <li>Process management with start/stop/restart</li>
            <li>Full ACP protocol support with permission and text request dialogs</li>
            <li>Slash command autocomplete</li>
            <li>Model picker and profile selector</li>
            <li>Plan tracking with step progress</li>
            <li>Tool call visualization with status</li>
        </ul>
        <h3>v0.1.0</h3>
        <ul>
            <li>Initial release with ACP-based communication</li>
            <li>Chat tool window for interacting with StemCode</li>
            <li>Session management</li>
            <li>Streaming responses</li>
        </ul>
    ]]></change-notes>

    <!-- Supported IDE versions -->
    <idea-version since-build="241" until-build="243.*"/>

    <!-- Resource bundle -->
    <resource-bundle>messages.StemCodeBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow
                id="StemCode"
                anchor="right"
                icon="StemCodeIcons.ToolWindow"
                factoryClass="com.stemcode.ui.StemCodeToolWindowFactory"
                doNotActivateOnStart="false"/>

        <!-- Application Service -->
        <applicationService
                serviceImplementation="com.stemcode.StemCodePlugin"/>
    </extensions>

    <applicationListeners>
        <listener
                class="com.stemcode.StemCodePlugin"
                topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <!-- Actions -->
    <actions>
        <!-- StemCode action group -->
        <group id="StemCodeActions"
               text="StemCode"
               popup="true"
               icon="StemCodeIcons.ToolWindow">

            <!-- Core actions -->
            <action id="StemCode.Start"
                    class="com.stemcode.actions.StartStemCodeAction"
                    text="StemCode: Start"
                    description="Start the StemCode process">
                <keyboard-shortcut first-keystroke="control alt N" keymap="$default"/>
            </action>

            <action id="StemCode.Stop"
                    class="com.stemcode.actions.StopStemCodeAction"
                    text="StemCode: Stop"
                    description="Stop the StemCode process"/>

            <action id="StemCode.Restart"
                    class="com.stemcode.actions.RestartStemCodeAction"
                    text="StemCode: Restart"
                    description="Restart the StemCode process"/>

            <separator/>

            <!-- Chat actions -->
            <action id="StemCode.OpenChat"
                    class="com.stemcode.actions.OpenChatAction"
                    text="StemCode: Open Chat"
                    description="Open the StemCode chat panel"
                    icon="StemCodeIcons.ToolWindow">
                <keyboard-shortcut first-keystroke="control shift N" keymap="$default"/>
            </action>

            <action id="StemCode.NewChat"
                    class="com.stemcode.actions.NewChatAction"
                    text="StemCode: New Chat"
                    description="Start a new StemCode chat session"/>

            <separator/>

            <!-- Editor integration actions -->
            <action id="StemCode.SendSelection"
                    class="com.stemcode.actions.SendSelectionAction"
                    text="StemCode: Send Selection"
                    description="Send the selected code to StemCode as context">
                <keyboard-shortcut first-keystroke="control shift S" keymap="$default"/>
            </action>

            <action id="StemCode.ExplainSelection"
                    class="com.stemcode.actions.ExplainSelectionAction"
                    text="StemCode: Explain Selection"
                    description="Ask StemCode to explain the selected code">
                <keyboard-shortcut first-keystroke="control shift E" keymap="$default"/>
            </action>

            <action id="StemCode.SendCurrentFile"
                    class="com.stemcode.actions.SendCurrentFileAction"
                    text="StemCode: Send Current File"
                    description="Send the current file content to StemCode as context"/>

            <action id="StemCode.ReviewCurrentFile"
                    class="com.stemcode.actions.ReviewCurrentFileAction"
                    text="StemCode: Review Current File"
                    description="Ask StemCode to review the current file for bugs"/>

            <action id="StemCode.ReviewGitDiff"
                    class="com.stemcode.actions.ReviewGitDiffAction"
                    text="StemCode: Review Git Diff"
                    description="Ask StemCode to review the current git diff"/>

            <action id="StemCode.PlanChanges"
                    class="com.stemcode.actions.PlanChangesAction"
                    text="StemCode: Plan Changes"
                    description="Ask StemCode to plan changes before editing"/>

            <action id="StemCode.ApplySuggestedChanges"
                    class="com.stemcode.actions.ApplySuggestedChangesAction"
                    text="StemCode: Apply Suggested Changes"
                    description="Apply the previous suggested changes"/>

            <separator/>

            <!-- Utility actions -->
            <action id="StemCode.OpenSettings"
                    class="com.stemcode.actions.OpenSettingsAction"
                    text="StemCode: Open Settings"
                    description="Open StemCode settings"/>

            <action id="StemCode.OpenLogs"
                    class="com.stemcode.actions.OpenLogsAction"
                    text="StemCode: Open Logs"
                    description="Open StemCode log output"/>
        </group>

        <!-- Add StemCode to main menu -->
        <group id="StemCode.MainMenu">
            <reference id="StemCodeActions"/>
        </group>

        <!-- Add to Tools menu -->
        <group id="ToolsMenuStemCode">
            <reference id="StemCodeActions"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <!-- Editor context menu integration -->
        <group id="StemCode.EditorContextMenu">
            <separator/>
            <reference id="StemCode.SendSelection"/>
            <reference id="StemCode.ExplainSelection"/>
            <reference id="StemCode.ReviewCurrentFile"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <!-- Editor title area (gutter icon area) -->
        <group id="StemCode.EditorTitle">
            <reference id="StemCode.OpenChat"/>
            <add-to-group group-id="EditorGutterActions" anchor="last"/>
        </group>

        <!-- Project view context menu -->
        <group id="StemCode.ProjectViewContext">
            <separator/>
            <reference id="StemCode.SendCurrentFile"/>
            <reference id="StemCode.ReviewCurrentFile"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
