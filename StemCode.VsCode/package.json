{
  "name": "stemcode",
  "displayName": "StemCode",
  "description": "Use StemCode inside VS Code through ACP mode.",
  "version": "0.0.1",
  "icon": "resources/logo.png",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rizwan3d/StemCode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizwan3d/StemCode.git",
    "directory": "StemCode.VsCode"
  },
  "bugs": {
    "url": "https://github.com/rizwan3d/StemCode/issues"
  },
  "keywords": [
    "stemcode",
    "ai",
    "coding-agent",
    "acp",
    "agent-client-protocol"
  ],
  "files": [
    "dist/**",
    "media/**",
    "resources/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "publisher": "growbitlab",
  "galleryBanner": {
    "color": "#101820",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:stemcode.openChat",
    "onCommand:stemcode.showTerminals",
    "onView:stemcode.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "stemcode",
          "title": "StemCode",
          "icon": "resources/logo.png"
        }
      ]
    },
    "views": {
      "stemcode": [
        {
          "type": "webview",
          "id": "stemcode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "stemcode.start",
        "title": "StemCode: Start"
      },
      {
        "command": "stemcode.stop",
        "title": "StemCode: Stop"
      },
      {
        "command": "stemcode.restart",
        "title": "StemCode: Restart"
      },
      {
        "command": "stemcode.openChat",
        "title": "StemCode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "stemcode.newChat",
        "title": "StemCode: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "stemcode.sendSelection",
        "title": "StemCode: Send Selection"
      },
      {
        "command": "stemcode.sendCurrentFile",
        "title": "StemCode: Send Current File"
      },
      {
        "command": "stemcode.reviewCurrentFile",
        "title": "StemCode: Review Current File"
      },
      {
        "command": "stemcode.reviewGitDiff",
        "title": "StemCode: Review Git Diff"
      },
      {
        "command": "stemcode.explainSelection",
        "title": "StemCode: Explain Selection"
      },
      {
        "command": "stemcode.planChanges",
        "title": "StemCode: Plan Changes"
      },
      {
        "command": "stemcode.applySuggestedChanges",
        "title": "StemCode: Apply Suggested Changes"
      },
      {
        "command": "stemcode.showTerminals",
        "title": "StemCode: Show Background Terminals",
        "icon": "$(terminal)"
      },
      {
        "command": "stemcode.openLogs",
        "title": "StemCode: Open Logs"
      },
      {
        "command": "stemcode.openSettings",
        "title": "StemCode: Open Settings"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stemcode.openChat",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "stemcode.newChat",
          "when": "view == stemcode.chatView",
          "group": "navigation@1"
        },
        {
          "command": "stemcode.start",
          "when": "view == stemcode.chatView",
          "group": "navigation@2"
        },
        {
          "command": "stemcode.showTerminals",
          "when": "view == stemcode.chatView",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "StemCode",
      "properties": {
        "stemcode.command": {
          "type": "string",
          "default": "stemcode",
          "description": "The command to run StemCode CLI."
        },
        "stemcode.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--acp"
          ],
          "description": "Arguments to pass to the StemCode CLI."
        },
        "stemcode.workingDirectory": {
          "type": "string",
          "description": "The working directory for the StemCode CLI. Defaults to workspace root."
        },
        "stemcode.acpAuthenticationToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional ACP authentication token. Used when the ACP server returns `authMethods: [\"token\"]`. The extension checks VS Code SecretStorage key `stemcode.acpAuthToken` first, then this setting, then environment variable `STEMCODE_ACP_AUTH_TOKEN`."
        },
        "stemcode.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Whether to start StemCode automatically when VS Code starts."
        },
        "stemcode.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "The log level for the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package:vsix": "vsce package --no-dependencies --githubBranch master",
    "publish:marketplace": "vsce publish --no-dependencies --githubBranch master"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  }
}
