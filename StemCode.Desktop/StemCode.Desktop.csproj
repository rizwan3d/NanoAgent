<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\StemCode\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StemCode\StemCode.csproj" />
  </ItemGroup>

  <!--
    Build/publish the Whisper "voice kit" (stemcode-voice) next to this host so voice
    dictation works without a separate install. Runs as an independent dotnet publish with
    an isolated intermediate path so it cannot contend with other builds of the project.
  -->
  <Target Name="PublishVoiceRuntime" AfterTargets="Build">
    <PropertyGroup>
      <VoiceRuntimeProject>$(MSBuildThisFileDirectory)..\StemCode.Voice\StemCode.Voice.csproj</VoiceRuntimeProject>
      <VoiceRuntimeOutput>$(OutDir)voice</VoiceRuntimeOutput>
    </PropertyGroup>
    <MakeDir Directories="$(VoiceRuntimeOutput)" />
    <Exec Condition="'$(RuntimeIdentifier)' != ''"
          Command="dotnet publish &quot;$(VoiceRuntimeProject)&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:SelfContained=true -o &quot;$(VoiceRuntimeOutput)&quot;" />
    <Exec Condition="'$(RuntimeIdentifier)' == ''"
          Command="dotnet publish &quot;$(VoiceRuntimeProject)&quot; -c $(Configuration) -r $(NETCoreSdkRuntimeIdentifier) -p:SelfContained=true -o &quot;$(VoiceRuntimeOutput)&quot;" />
  </Target>

</Project>
